#!/bin/bash
# pre-commit hook for reportabuseipdb. Enable once per clone:
#   git config core.hooksPath tools
# Checks staged files: bash syntax + shellcheck for *.sh, Python syntax for *.py,
# the EN/PL documentation pairing rule, the version rules, the privacy scan and, when a commit changes the generator
# (or its test file), the generator tests (see docs/DEVELOPMENT.md).
# The privacy rules live in tools/lib-privacy.sh (shared with tools/commit-msg, which scans the message).
# Bypass only knowingly: git commit --no-verify
# Contributors who write English only: EN_ONLY=1 git commit ... skips just the EN/PL pairing rule (the maintainer adds
# the Polish translation); every other check, including the privacy scan, still runs.
# NO_TESTS=1 git commit ... skips just the generator tests (for a work-in-progress commit); every other check still
# runs, and CI runs the tests anyway before anything is merged.
fail=0
testdir=""   # temporary copy of the index for the generator tests; set below, removed by the trap
# shellcheck source=lib-privacy.sh
. "$(cd "$(dirname "$0")" && pwd)/lib-privacy.sh"
staged=()   # portable (no mapfile: macOS ships bash 3.2)
while IFS= read -r -d '' path; do staged+=("$path"); done < <(git diff --cached --name-only --diff-filter=ACMR -z)
mk() { mktemp "${TMPDIR:-/tmp}/pre-commit.XXXXXX"; }   # explicit template: works where the default temp dir is not writable
tmp="$(mk)"; scan="$(mk)"; markers="$(mk)"
trap 'rm -f "$tmp" "$scan" "$markers"; if [ -n "$testdir" ]; then rm -rf "$testdir"; fi' EXIT

for f in "${staged[@]}"; do
    case "$f" in
        *.sh)
            if ! git show ":$f" | bash -n 2> "$tmp"; then
                echo "SYNTAX ERROR in $f:"; cat "$tmp"; fail=1; continue
            fi
            if ! command -v shellcheck > /dev/null; then
                echo "note: shellcheck is not installed, $f was only syntax-checked (CI runs shellcheck)"
            elif ! git show ":$f" | shellcheck -S error -s bash - > "$tmp" 2>&1; then
                echo "SHELLCHECK (error) in $f:"; cat "$tmp"; fail=1
            fi
            ;;
        *.py)
            if ! git show ":$f" | python3 -c 'import sys; compile(sys.stdin.read(), sys.argv[1], "exec")' "$f" 2> "$tmp"; then
                echo "PYTHON SYNTAX ERROR in $f:"; cat "$tmp"; fail=1
            fi
            ;;
    esac
done

# EN/PL pairs: README.md <-> README.pl.md (the only Polish file in the root); every other document lives in the
# Polish tree: X.md <-> docs/pl/X.md (X = CHANGELOG, CONTRIBUTING, SECURITY, CODE_OF_CONDUCT) and docs/X.md <-> docs/pl/X.md.
# The root names must come before the generic docs/pl/*.md rule, which would map them to docs/X.md.
pair_of() {
    case "$1" in
        README.md) echo "README.pl.md" ;;
        README.pl.md) echo "README.md" ;;
        CHANGELOG.md|CONTRIBUTING.md|SECURITY.md|CODE_OF_CONDUCT.md) echo "docs/pl/$1" ;;
        docs/pl/CHANGELOG.md|docs/pl/CONTRIBUTING.md|docs/pl/SECURITY.md|docs/pl/CODE_OF_CONDUCT.md) echo "${1#docs/pl/}" ;;
        docs/pl/*.md) echo "docs/${1#docs/pl/}" ;;
        docs/*.md) echo "docs/pl/${1#docs/}" ;;
    esac
}
in_staged() { local x; for x in "${staged[@]}"; do [ "$x" = "$1" ] && return 0; done; return 1; }

for f in "${staged[@]}"; do
    [ "${EN_ONLY:-0}" = "1" ] && break   # contributor mode: no Polish twin required
    other="$(pair_of "$f")"
    [ -n "$other" ] || continue
    if [ ! -f "$other" ]; then
        echo "MISSING TRANSLATION: $f has no counterpart $other"; fail=1
    elif ! in_staged "$other"; then
        echo "EN/PL MISMATCH: $f is staged but $other is not (update both language versions)"; fail=1
    else
        en_h="$(git show ":$f" | grep -c '^#')"; pl_h="$(git show ":$other" | grep -c '^#')"
        [ "$en_h" = "$pl_h" ] || { echo "HEADING COUNT DIFFERS: $f ($en_h) vs $other ($pl_h)"; fail=1; }
    fi
done

# Version rules (docs/DEVELOPMENT.md, "Versioning"): the project has ONE version, SCRIPT_VERSION in
# abuseipdb_report.py, repeated in abuseipdb_send.sh. A commit that CHANGES it must make exactly one allowed
# step: Z+1 (fix), Y+1 with Z=0 (new feature) or X+1 with Y=Z=0 (breaking change). Z has no upper limit. A commit
# that leaves the version alone passes (contributors never bump it; the maintainer does when merging).
# The wrapper must always carry the same version as the generator.
is_next_ver() {   # is_next_ver <old> <new>: succeeds when <new> is one allowed step after <old>
    local ox oy oz nx ny nz
    IFS=. read -r ox oy oz <<< "$1"
    IFS=. read -r nx ny nz <<< "$2"
    ox=$((10#$ox)); oy=$((10#$oy)); oz=$((10#$oz)); nx=$((10#$nx)); ny=$((10#$ny)); nz=$((10#$nz))
    [ "$nx.$ny.$nz" = "$ox.$oy.$((oz + 1))" ] && return 0
    [ "$nx.$ny.$nz" = "$ox.$((oy + 1)).0" ] && return 0
    [ "$nx.$ny.$nz" = "$((ox + 1)).0.0" ]
}
version_in() {   # version_in <git object> <sed pattern for the assignment>
    git show "$1" 2> /dev/null | sed -n "s/^$2\"\([0-9]*\.[0-9]*\.[0-9]*\)\".*/\1/p" | head -1
}
if [ "${#staged[@]}" -gt 0 ]; then
    pyver="$(version_in :abuseipdb_report.py 'SCRIPT_VERSION = ')"
    old="$(version_in HEAD:abuseipdb_report.py 'SCRIPT_VERSION = ')"
    if [ -z "$pyver" ]; then
        echo "VERSION MISSING: no SCRIPT_VERSION found in abuseipdb_report.py"; fail=1
    elif [ -n "$old" ] && [ "$pyver" != "$old" ] && ! is_next_ver "$old" "$pyver"; then
        echo "VERSION STEP: abuseipdb_report.py has $pyver after $old. Allowed: Z+1, or Y+1 with Z=0, or X+1 with Y=Z=0."; fail=1
    fi
    shver="$(version_in :abuseipdb_send.sh 'SCRIPT_VERSION=')"
    if [ -z "$shver" ]; then
        echo "VERSION MISSING: no SCRIPT_VERSION found in abuseipdb_send.sh"; fail=1
    elif [ -n "$pyver" ] && [ "$shver" != "$pyver" ]; then
        echo "VERSION MISMATCH: abuseipdb_send.sh has $shver, abuseipdb_report.py has $pyver (one version for the project)"; fail=1
    fi
fi

# Privacy scan. The lines being added must not reveal the operator's own domains or host
# names (OWN_NAME_MARKERS of the local config, which is never in the repository), a real
# API key, or a committed config file. Only the author's contact details are allowed in the
# repository; privacy_strip (tools/lib-privacy.sh) removes exactly those before scanning.
# No config = scan skipped.
conf="$privacy_conf"
for f in "${staged[@]}"; do
    case "$(basename "$f")" in
        abuseipdb.conf) echo "PRIVACY: $f is the real config file (secrets and host names) - never commit it"; fail=1 ;;
    esac
done
git diff --cached -U0 --no-color --diff-filter=ACMR | grep '^+' | grep -v '^+++ ' > "$tmp"
privacy_strip < "$tmp" > "$scan"
if grep -nE '[0-9a-fA-F]{80}|^\+(ABUSEIPDB_API_KEY|NTFY_TOPIC)=[^Yy]' "$scan" > "$tmp"; then
    echo "PRIVACY: an added line looks like a real API key or ntfy topic:"; cut -c1-60 "$tmp"; fail=1
fi
privacy_markers "$markers"
if [ -s "$markers" ]; then
    if grep -inF -f "$markers" "$scan" > "$tmp"; then
        echo "PRIVACY: added lines contain your own domain/host names (OWN_NAME_MARKERS in $conf):"
        cut -c1-140 "$tmp"; fail=1
    fi
else
    echo "note: privacy scan of own names skipped (no OWN_NAME_MARKERS in $conf)"
fi

# Generator tests (about 15 s, so only when the commit touches the generator or its test file; the full suite takes
# minutes and the wrapper tests need Linux, so CI keeps those). They run on a copy of the INDEX, not on the working
# tree: the hook must judge what is about to be committed, even if you have other unstaged edits.
# They are skipped when an earlier check already failed (the commit is refused anyway; no reason to wait), and when the
# test file is not in the index (the throw-away repositories of tests/test_hooks.py have none).
if in_staged abuseipdb_report.py || in_staged tests/test_abuseipdb_report.py; then
    if [ "${NO_TESTS:-0}" = "1" ]; then
        echo "note: generator tests skipped (NO_TESTS=1); CI still runs them"
    elif [ "$fail" -ne 0 ]; then
        echo "note: generator tests not run because of the errors above"
    elif ! git cat-file -e :tests/test_abuseipdb_report.py 2> /dev/null; then
        echo "note: generator tests skipped (tests/test_abuseipdb_report.py is not in the index)"
    else
        testdir="$(mktemp -d "${TMPDIR:-/tmp}/pre-commit-tests.XXXXXX")"
        if ! git checkout-index --all --prefix="$testdir/"; then
            echo "GENERATOR TESTS: could not copy the index to a temporary directory"; fail=1
        elif (cd "$testdir" && python3 -m unittest tests.test_abuseipdb_report) > "$tmp" 2>&1; then
            echo "generator tests passed"
        else
            echo "GENERATOR TESTS FAILED (last lines; run: python3 -m unittest tests.test_abuseipdb_report):"
            tail -n 30 "$tmp"; fail=1
        fi
    fi
fi

[ "$fail" -eq 0 ] || { echo "Commit aborted. Fix the problems or use: git commit --no-verify"; exit 1; }
